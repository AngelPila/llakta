# Elige UNO. Sin ninguna clave, Llakta corre en modo demo (agentes simulados).
# Gemini (gratis en Google AI Studio, sin tarjeta): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (gratis, muy rápido): https://console.groq.com/keys
GROQ_API_KEY=
# DeepSeek (de pago, muy barato): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Claude (de pago; Haiku 5.5 cuesta centavos por proyecto)
ANTHROPIC_API_KEY=
# Forzar un proveedor: gemini | groq | deepseek | ollama | anthropic | demo
LLAKTA_PROVIDER=
# Opcional: cambiar modelos
LLM_MODEL=
LLM_FAST_MODEL=
# Publicada en un servidor:
# ids de proyectos a mostrar en el inicio, separados por coma (vacío = todos)
LLAKTA_DESTACADOS=
# tope de proyectos nuevos por día en todo el servidor (0 = sin tope)
LLAKTA_MAX_PROYECTOS_DIA=60
